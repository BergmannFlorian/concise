---
/**
 * Pages not built yet. When a real page is created (e.g. src/pages/[...lang]/politique.astro),
 * remove its entry from `pending` below.
 */
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCommune } from '../../lib/content';
import { langList, defaultLang, langFromParam, useTranslations, type PageKey, type UIKey } from '../../i18n/ui';

export function getStaticPaths() {
  // (defined here: getStaticPaths cannot see variables from the rest of the frontmatter)
  const pending: { slug: string; key: PageKey; label: UIKey }[] = [
    { slug: 'vie-quotidienne', key: 'vie', label: 'nav.vie' },
    { slug: 'locations', key: 'locations', label: 'nav.locations' },
    { slug: 'contact', key: 'contact', label: 'nav.contact' },
  ];
  return langList.flatMap((lang) =>
    pending.map((page) => ({
      params: { lang: lang === defaultLang ? undefined : lang, section: page.slug },
      props: { page },
    })),
  );
}

const { page } = Astro.props;
const lang = langFromParam(Astro.params.lang);
const t = useTranslations(lang);
const commune = await getCommune();
---

<Base lang={lang} current={page.key} title={t(page.label)}>
  <PageHeader lang={lang} title={t(page.label)} intro={t('soon.title')} />
  <div class="container">
    <p class="soon">{t('soon.text')} <a href={commune.siteOfficiel}>concise.ch</a></p>
  </div>
</Base>

<style>
  .soon {
    margin: 48px 0 0;
    padding: 26px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    font-size: 16px;
    color: var(--text-2);
  }
</style>

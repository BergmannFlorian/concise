---
/**
 * Link that automatically adds the language prefix to internal links
 * ('/services#port' → '/de/services#port'). External links and anchors are left as is.
 */
import type { HTMLAttributes } from 'astro/types';
import { localizePath, type Lang } from '../i18n/ui';

type Props = HTMLAttributes<'a'> & { href: string; lang: Lang };
const { href, lang, ...rest } = Astro.props;
const finalHref = href.startsWith('/') ? localizePath(href, lang) : href;
---

<a href={finalHref} {...rest}><slot /></a>

---
/**
 * "Page not found" page content (full page, with layout). Used by src/pages/404.astro (French, also the
 * dev server's 404) and src/pages/[...lang]/404.astro (German, English).
 */
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { BASE, defaultLang, langList, localizePath, navItems, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const useful = [...navItems.filter((i) => i.key !== 'home'), { key: 'contact', path: '/contact', label: 'nav.contact' } as const];

// GitHub Pages serves this French page for every unknown URL: send /de/… and /en/… visitors to
// their language's 404 (production only, so `astro dev` never loops).
const redirectOtherLangs = lang === defaultLang && import.meta.env.PROD;
const otherLangs = langList.filter((l) => l !== defaultLang);
---

{
  redirectOtherLangs && (
    <script is:inline define:vars={{ base: BASE, langs: otherLangs }}>
      var m = location.pathname.slice(base.length).match(/^\/([a-z]{2})\//);
      if (m && langs.indexOf(m[1]) !== -1 && !/\/404(\.html)?$/.test(location.pathname)) {
        location.replace(base + '/' + m[1] + '/404.html');
      }
    </script>
  )
}

<Base lang={lang} title={t('error.title')} errorPage>
  <section class="container error">
    <div class="text">
      <p class="eyebrow">{t('error.code')}</p>
      <h1>{t('error.title')}</h1>
      <p class="lead">{t('error.text')}</p>
      <div class="actions">
        <a href={localizePath('/', lang)} class="btn-primary">{t('error.home')}</a>
        <button type="button" class="pill search" data-search-open>
          <Icon name="recherche" size={18} strokeWidth={2} />
          {t('error.search')}
        </button>
      </div>
    </div>
    <p class="code" aria-hidden="true">404</p>
  </section>

  <section class="container useful" aria-labelledby="useful-title">
    <h2 id="useful-title">{t('error.useful')}</h2>
    <ul>
      {
        useful.map((item) => (
          <li>
            <a href={localizePath(item.path, lang)}>
              <span>{t(item.label)}</span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .error {
    padding-top: 56px;
    display: flex;
    flex-wrap: wrap;
    gap: 24px 48px;
    align-items: center;
    justify-content: space-between;
  }
  .text {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  h1 {
    font-size: clamp(44px, 6vw, 80px);
    line-height: 1;
    letter-spacing: -0.025em;
  }
  .lead {
    margin: 0;
    max-width: 560px;
    font-size: 18px;
    line-height: 1.55;
    color: var(--text-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
  .search {
    background: transparent;
    font: inherit;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    /* Search needs JS. */
    display: none;
  }
  :global(html.js) .search {
    display: inline-flex;
  }
  .code {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(120px, 20vw, 260px);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--accent-soft);
    -webkit-text-stroke: 2px var(--accent);
    user-select: none;
  }

  .useful {
    padding-top: 80px;
  }
  .useful h2 {
    font-size: 28px;
    margin-bottom: 16px;
  }
  .useful ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0 32px;
    border-top: 1px solid var(--rule);
  }
  .useful a {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--text);
    font-size: 17px;
    font-weight: 500;
  }
  .useful a:hover {
    color: var(--accent);
  }
</style>

---
/** Inner page header: breadcrumb, large title, intro, then optional content (slot). */
import { localizePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  intro?: string;
  /** Intermediate breadcrumb level (e.g. the notice board for a single notice). */
  parent?: { label: string; href: string };
  /** Smaller title, for long titles such as a single notice. */
  compact?: boolean;
  /** Breadcrumb label when it differs from the title (e.g. "Vie quotidienne" vs "Vivre à Concise"). */
  crumb?: string;
}
const { lang, title, intro, parent, compact = false, crumb } = Astro.props;
const t = useTranslations(lang);
---

<section class="container page-header">
  <nav aria-label={t('breadcrumb')} class="breadcrumb">
    <ol>
      <li><a href={localizePath('/', lang)}>{t('nav.home')}</a></li>
      {parent && <li><a href={parent.href}>{parent.label}</a></li>}
      <li aria-current="page">{crumb ?? title}</li>
    </ol>
  </nav>
  <div class="head">
    <h1 class:list={{ compact }}>{title}</h1>
    {intro && <p>{intro}</p>}
  </div>
  <slot />
</section>

<style>
  .page-header {
    padding-top: 40px;
  }
  .breadcrumb {
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 20px;
  }
  .breadcrumb ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
  }
  .breadcrumb li + li::before {
    content: '/';
    margin: 0 8px;
  }
  .breadcrumb a {
    color: var(--muted);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 48px;
    align-items: flex-end;
    justify-content: space-between;
  }
  h1 {
    font-size: clamp(44px, 6vw, 80px);
    line-height: 1;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
  }
  h1.compact {
    font-size: clamp(32px, 4.5vw, 52px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 22ch;
  }
  p {
    margin: 0;
    max-width: 440px;
    font-size: 18px;
    line-height: 1.55;
    color: var(--text-2);
  }
</style>
